# Origin of the Socket.IO multiplayer server. Vite inlines VITE_* vars at BUILD
# time, so this must be set before `npm run build` (not at runtime).
VITE_SERVER_URL=http://localhost:3001

# External URL for Stockfish WASM engine (JS + WASM blob).
# If unset, the local public/stockfish/ assets are used (dev default).
# Must point to the .js file with the .wasm path in the hash fragment.
# Example: https://cdn.example.com/stockfish-18-single.js#https://cdn.example.com/stockfish-18-single.wasm
# VITE_STOCKFISH_URL=
